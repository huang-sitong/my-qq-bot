BASE_URL = <your-baseurl>
API_KEY = <your-apikey>

TAVILY_API_KEY = <your-tavily-apikey>

# --- MCP 外部工具（可选） ---
# BOT_MCP_ENABLED = 1
# BOT_MCP_SERVERS = {}
# BOT_MCP_TOOL_NAME_PREFIX = 0

# --- LLM (可选覆盖) ---
# BOT_LLM_MODEL = sensenova-6.7-flash-lite
# BOT_LLM_TEMPERATURE = 0.7
# BOT_LLM_MULTIMODAL = 0   # 主 LLM 多模态时置 1：图片直接进主 LLM，本地视觉仅作 RAG 索引

# --- RAG 群聊历史向量检索 (默认启用) ---
# BOT_RAG_ENABLED = 1
# BOT_EMBED_MODEL = qwen3-embedding:0.6b
# OLLAMA_BASE_URL = http://localhost:11434
# BOT_EMBED_DIMENSIONS = 1024
# BOT_RAG_TOP_K = 5
# BOT_RAG_SCORE_THRESHOLD = 0.35
# BOT_RAG_RETENTION_PER_THREAD = 2000
# BOT_RAG_MAX_AGENT_ROUNDS = 7

# --- Skills 提示词包技能 (默认启用) ---
# BOT_SKILLS_ENABLED = 1
# BOT_SKILLS_DIR = skills
# BOT_SKILLS_INDEX_MAX = 50

