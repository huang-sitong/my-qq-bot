BASE_URL = <your-baseurl>
API_KEY = <your-apikey>

# --- Transport ---
# BOT_WS_URL = ws://localhost:5600/v1/events
# BOT_TOKEN =   # 未在 LLOneBot 设置令牌时留空（默认不发送 Authorization）
# BOT_RECONNECT = 1
# BOT_MAX_RECONNECT_DELAY = 30
# BOT_API_BASE_URL = http://localhost:5600
# BOT_API_PLATFORM = llonebot

# --- LLM ---
# BOT_LLM_MODEL = sensenova-6.7-flash-lite
# BOT_LLM_TEMPERATURE = 0.7
# BOT_LLM_MAX_RETRIES = 1
# BOT_LLM_REQUEST_TIMEOUT = 30
# BOT_LLM_MULTIMODAL = 0   # 主 LLM 多模态时置 1
# BOT_LLM_CONTEXT_WINDOW = 200000

# --- Summary ---
# BOT_SUMMARY_TRIGGER_RATIO = 0.8
# BOT_SUMMARY_KEEP_RATIO = 0.2
# BOT_SUMMARY_MAX_INPUT_TOKENS = 8000

# --- Storage / Persona ---
# BOT_DB_DIR = db
# BOT_PERSONA_PROMPT = 你是一个AI助手，名字叫 "{bot_name}"，请用中文友好地回答问题。

# --- RAG / Embedding ---
# BOT_RAG_ENABLED = 1
# BOT_EMBED_MODEL = qwen3-embedding:0.6b
# OLLAMA_BASE_URL = http://localhost:11434
# BOT_EMBED_DIMENSIONS = 1024
# BOT_EMBED_CACHE_ENABLED = 1
# BOT_EMBED_CACHE_MAX_ENTRIES = 20000
# BOT_RAG_TOP_K = 5
# BOT_RAG_SCORE_THRESHOLD = 0.35
# BOT_RAG_RETENTION_PER_THREAD = 2000
# BOT_RAG_MAX_AGENT_ROUNDS = 7

# --- Vision ---
# BOT_VISION_ENABLED = 1
# BOT_VISION_MODEL = qwen3-vl:2b
# BOT_VISION_MAX_IMAGES = 3
# BOT_VISION_TIMEOUT = 60

# --- MCP ---
# BOT_MCP_ENABLED = 0
# BOT_MCP_SERVERS = {}
# BOT_MCP_TOOL_NAME_PREFIX = 0
TAVILY_API_KEY = <your-tavily-apikey>

