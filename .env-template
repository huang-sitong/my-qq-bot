# --- LLM ---
# BASE_URL = <your-baseurl>
# API_KEY = <your-apikey>
# BOT_LLM_MODEL = deepseek-v4-flash
# BOT_LLM_TEMPERATURE = 0.7
# BOT_LLM_MAX_RETRIES = 1
# BOT_LLM_REQUEST_TIMEOUT = 30
# BOT_LLM_MULTIMODAL = 0   # 主 LLM 多模态时置 1
# BOT_LLM_CONTEXT_WINDOW = 200000

# --- Transport ---
# BOT_WS_URL = ws://localhost:5600/v1/events
# BOT_TOKEN =   # 未在 LLOneBot 设置令牌时留空（默认不发送 Authorization）
# BOT_RECONNECT = 1
# BOT_MAX_RECONNECT_DELAY = 30
# BOT_API_BASE_URL = http://localhost:5600
# BOT_ONEBOT11_API_BASE_URL = http://localhost:3000   # send_file 的普通文件走 OneBot11 HTTP
# BOT_ONEBOT11_TIMEOUT = 60   # send_file 走 OneBot11 HTTP 的读取/总响应超时上限（秒）
# BOT_API_PLATFORM = llonebot

# --- Message concurrency ---
# BOT_MESSAGE_WORKER_COUNT = 1   # asyncio worker 数量；>1 时不同 thread_id 可并发处理，同一会话仍串行
# BOT_MESSAGE_QUEUE_MAXSIZE = 0  # 消息队列上限；0=无界，正整数=满时入队阻塞产生背压
# BOT_MESSAGE_BATCH_MAX = 4      # 同会话突发消息合并上限：一次图调用/一条回复处理多条；0 或 1=逐条处理

# --- Graph ---
# BOT_GRAPH_RECURSION_LIMIT = 128   # LangGraph 图节点执行上限（call_llm/tools/skill_manager 等工具回环会消耗）

# --- Summary ---
# BOT_SUMMARY_TRIGGER_RATIO = 0.8
# BOT_SUMMARY_KEEP_RATIO = 0.2
# BOT_SUMMARY_MAX_INPUT_TOKENS = 8000

# --- Storage / Persona ---
# BOT_DB_DIR = db
# BOT_PERSONA_PROMPT = 你是一个AI助手，名字叫 "{bot_name}"，请用中文友好地回答问题。

# --- RAG / Embedding ---
# BOT_RAG_ENABLED = 1
# BOT_EMBED_MODEL = qwen3-embedding:0.6b
# BOT_EMBED_BASE_URL = https://api.example.com/v1  # 嵌入专用；未设置时回落 BASE_URL
# BOT_EMBED_API_KEY = sk-xxx                       # 嵌入专用；未设置时回落 API_KEY
# BOT_EMBED_DIMENSIONS = 1024
# BOT_EMBED_CACHE_ENABLED = 1
# BOT_EMBED_CACHE_MAX_ENTRIES = 20000
# BOT_RAG_TOP_K = 5
# BOT_RAG_SCORE_THRESHOLD = 0.35
# BOT_RAG_RETENTION_PER_THREAD = 2000
# BOT_RAG_MAX_AGENT_ROUNDS = 12

# --- Vision (OpenAI 兼容视觉 API，图片描述) ---
# BOT_VISION_ENABLED = 1
# BOT_VISION_MODEL = qwen-vl-max        # 供应商的 OpenAI 兼容视觉模型名
# BOT_VISION_BASE_URL = https://api.example.com/v1  # 视觉专用；未设置时回落 BASE_URL
# BOT_VISION_API_KEY = sk-xxx           # 视觉专用；未设置时回落 API_KEY
# BOT_VISION_MAX_IMAGES = 3
# BOT_VISION_TIMEOUT = 60

# --- MCP ---
# BOT_MCP_ENABLED = 0
# BOT_MCP_SERVERS_FILE = config/mcp_servers.json   # MCP server 定义文件（可提交；密钥用 ${ENV_VAR} 占位）
# BOT_MCP_TOOL_NAME_PREFIX = 0
# TAVILY_API_KEY = <your-tavily-apikey>

# --- Skills ---
# BOT_SKILLS_ENABLED = 1
# BOT_SKILLS_DIR = skills
# BOT_SKILLS_INDEX_MAX = 50

# --- Commands ---
# BOT_COMMAND_ENABLED = 1
# BOT_COMMAND_PREFIX = /
# BOT_ADMIN_IDS = id1,id2

# --- Reply behavior ---
# BOT_AUTO_REPLY = 0   # 群聊非@文本/图片自动回复（管理员可经 /auto_reply 运行时改写）
# BOT_AUTO_REPLY_RANDOM_RATE = 0.3   # auto_reply 非@消息的回复概率（0-1）
# BOT_AUTO_REPLY_COOLDOWN = 30       # 同一 thread 两次 auto_reply 最小间隔秒数

# --- Bash 工具（run_bash：skill 脚本执行；Git Bash） ---
# BOT_BASH_ENABLED = 1      # 是否启用 run_bash（默认开；护栏兜底）
# BOT_BASH_SHELL = <your-bash-path>   # 本机 Git Bash；默认 bash 可能解析为 WSL
# BOT_BASH_TIMEOUT = 30     # 秒
# BOT_BASH_MAX_OUTPUT = 4000   # 输出截断字符数
# 逗号分隔额外白名单根目录（项目根恒隐式允许；如 C:/data,D:/tmp）。空值勿写行内注释——dotenv 会把「# 注释」当成值
# BOT_BASH_ALLOWED_ROOTS =
